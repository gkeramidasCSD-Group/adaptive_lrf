{
  "cmd": "train",
  "arch": "mnist_lenet_5",
  "dataset": "mnist",
  "epochs": 100,
  "batch_size": 128,
  "optimizer": "sgd",
  "lr": 0.001,
  "momentum": 0.9,
  "weight_decay": 0.0001,
  "criterion": "cross_entropy",
  "criterion_kwargs": {
    "label_smoothing": 0.1
  },
  "metric": "accuracy"
}